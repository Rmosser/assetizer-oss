{
  "manifest_version": 3,
  "name": "课代表 · 选片篮",
  "version": "0.1.0",
  "description": "在 YouTube 上勾选视频，攒进选片篮，交给课代表读成专题。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "contextMenus"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://assetizer.prodbox.heiyu.space/*",
    "https://assetizer.devbox.heiyu.space/*",
    "http://localhost:5173/*",
    "http://localhost:8771/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_title": "选片篮",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "side_panel": { "default_path": "panel.html" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/basket.js", "src/sites/youtube.js", "src/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://assetizer.prodbox.heiyu.space/*",
        "https://assetizer.devbox.heiyu.space/*",
        "http://localhost:5173/*",
        "http://localhost:8771/*"
      ],
      "js": ["src/boxes.js", "src/basket.js", "src/bridge.js"],
      "run_at": "document_start"
    }
  ]
}
